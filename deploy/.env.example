# ---------------------------------------------------------------------------
# Per-environment configuration for docker-compose.yml.
#
# Deployed environments: the FULL contents of this file are stored as the
# GitHub Environment secret APP_ENV_FILE (one per environment: development,
# uat, production). CI writes it to the server as .env on every deploy, so
# GitHub is the single source of truth. Never commit a filled-in copy.
#
# Local: copy to the repo root as ".env" and fill in.
# ---------------------------------------------------------------------------

# development | uat | production (also isolates container/volume names)
APP_ENV=development

# Public URL users open (no trailing slash). Used for CORS and email links.
PUBLIC_URL=http://localhost:5000

# Host port the app listens on (behind the reverse proxy). Use different ports
# if two environments share one server, e.g. dev=5001, uat=5002.
APP_PORT=5000

# --- PostgreSQL (use a different strong password per environment) ---
# Letters and digits only: the password is embedded in a connection URL.
POSTGRES_USER=kindfood
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=kindfood

# --- Redis ---
REDIS_PASSWORD=change_me_dev_only

# --- Email (NODE_ENV is "production" in the image, so SMTP is required) ---
# Dev/UAT: use a sandbox SMTP inbox (e.g. Mailtrap) so no real emails go out.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kind Food <no-reply@kindfood.local>"
ACTIVATION_TOKEN_TTL_MINUTES=1440

# --- Local only (CI sets these on servers; do NOT put them in APP_ENV_FILE) ---
DOCKERHUB_IMAGE=kind-food-app
IMAGE_TAG=local
