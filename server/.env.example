NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string used by Prisma.
# Example: postgresql://postgres:postgres@localhost:5432/king_food_app?schema=public
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/king_food_app?schema=public
DATABASE_URL="postgresql://kingfood:kingfood123@localhost:5432/kingfood_db?schema=public"

# Public URL of this API, used to build the link in activation emails.
API_BASE_URL=http://localhost:5000
# How long an activation link stays valid (minutes). Default: 1440 (24h).
ACTIVATION_TOKEN_TTL_MINUTES=1440

# SMTP for outgoing email. If SMTP_HOST is empty and NODE_ENV is not
# "production", emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kind Food <no-reply@kindfood.local>"
