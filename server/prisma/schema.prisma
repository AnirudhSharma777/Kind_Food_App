generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING
}

enum RestaurantStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD
  UPI
  WALLET
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum NotificationType {
  ORDER_UPDATE
  PROMOTION
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  email               String              @unique @db.VarChar(320)
  phone               String?             @unique @db.VarChar(30)
  passwordHash        String?             @db.VarChar(255)
  firstName           String?             @db.VarChar(100)
  lastName            String?             @db.VarChar(100)
  status              UserStatus          @default(PENDING)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  roles               UserRole[]
  ownedRestaurants    Restaurant[]        @relation("RestaurantOwner")
  managedStores       Store[]             @relation("StoreManager")
  addresses           Address[]
  carts               Cart[]
  orders              Order[]
  deliveries          Delivery[]          @relation("DeliveryPartner")
  reviews             Review[]
  notifications       Notification[]
  couponRedemptions   CouponRedemption[]

  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Restaurant {
  id           String             @id @default(uuid()) @db.Uuid
  ownerId      String             @db.Uuid
  name         String             @db.VarChar(150)
  slug         String             @unique @db.VarChar(180)
  description  String?
  phone        String?            @db.VarChar(30)
  status       RestaurantStatus   @default(DRAFT)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  owner        User               @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  stores       Store[]
  categories   Category[]
  products     Product[]
  orders       Order[]
  coupons      Coupon[]
  reviews      Review[]           @relation("RestaurantReviews")
  commissions  Commission[]
  payouts      Payout[]

  @@index([ownerId])
  @@index([status])
}

model Store {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @db.Uuid
  managerId    String?       @db.Uuid
  name         String        @db.VarChar(150)
  code         String        @db.VarChar(50)
  phone        String?       @db.VarChar(30)
  addressLine1 String        @db.VarChar(255)
  addressLine2 String?       @db.VarChar(255)
  city         String        @db.VarChar(100)
  state        String        @db.VarChar(100)
  postalCode   String        @db.VarChar(20)
  country      String        @default("IN") @db.Char(2)
  latitude     Decimal?      @db.Decimal(9, 6)
  longitude    Decimal?      @db.Decimal(9, 6)
  status       StoreStatus   @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  manager      User?         @relation("StoreManager", fields: [managerId], references: [id], onDelete: SetNull)
  inventories  Inventory[]
  carts        Cart[]
  orders       Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId, status])
  @@index([managerId])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  label      String   @db.VarChar(50)
  line1      String   @db.VarChar(255)
  line2      String?  @db.VarChar(255)
  city       String   @db.VarChar(100)
  state      String   @db.VarChar(100)
  postalCode String   @db.VarChar(20)
  country    String   @default("IN") @db.Char(2)
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Category {
  id           String           @id @default(uuid()) @db.Uuid
  restaurantId String           @db.Uuid
  parentId     String?          @db.Uuid
  name         String           @db.VarChar(100)
  slug         String           @db.VarChar(120)
  description  String?
  sortOrder    Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  parent       Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]       @relation("CategoryTree")
  products     ProductCategory[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, isActive, sortOrder])
  @@index([parentId])
}

model Product {
  id           String             @id @default(uuid()) @db.Uuid
  restaurantId String             @db.Uuid
  name         String             @db.VarChar(180)
  slug         String             @db.VarChar(200)
  description  String?
  basePrice    Decimal            @db.Decimal(10, 2)
  imageUrl     String?            @db.VarChar(500)
  status       ProductStatus      @default(DRAFT)
  isAvailable  Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories   ProductCategory[]
  variants     ProductVariant[]
  reviews      Review[]           @relation("ProductReviews")

  @@unique([restaurantId, slug])
  @@index([restaurantId, status, isAvailable])
}

model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductVariant {
  id          String      @id @default(uuid()) @db.Uuid
  productId   String      @db.Uuid
  name        String      @db.VarChar(100)
  sku         String      @unique @db.VarChar(80)
  price       Decimal     @db.Decimal(10, 2)
  isDefault   Boolean     @default(false)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventories Inventory[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@unique([productId, name])
  @@index([productId, isActive])
}

model Inventory {
  id              String         @id @default(uuid()) @db.Uuid
  storeId         String         @db.Uuid
  variantId       String         @db.Uuid
  quantity        Int            @default(0)
  reservedQuantity Int           @default(0)
  lowStockAt      Int            @default(5)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([storeId, variantId])
  @@index([storeId, quantity])
  @@index([variantId])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  storeId   String?    @db.Uuid
  couponId  String?    @db.Uuid
  status    CartStatus @default(ACTIVE)
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  coupon    Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items     CartItem[]

  @@index([storeId, status])
  @@index([status, expiresAt])
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int            @default(1)
  unitPrice Decimal        @db.Decimal(10, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id              String              @id @default(uuid()) @db.Uuid
  orderNumber     String              @unique @default(cuid()) @db.VarChar(30)
  userId          String              @db.Uuid
  restaurantId    String              @db.Uuid
  storeId         String              @db.Uuid
  couponId        String?             @db.Uuid
  status          OrderStatus         @default(PENDING)
  currency        String              @default("INR") @db.Char(3)
  subtotal        Decimal             @db.Decimal(12, 2)
  discountAmount  Decimal             @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal             @db.Decimal(12, 2)
  deliveryAddress Json
  placedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  coupon          Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  delivery        Delivery?
  commission      Commission?
  couponRedemption CouponRedemption?
  reviews         Review[]

  @@index([userId, status])
  @@index([restaurantId, status, createdAt])
  @@index([storeId, createdAt])
}

model OrderItem {
  id        String         @id @default(uuid()) @db.Uuid
  orderId   String         @db.Uuid
  variantId String?        @db.Uuid
  productName String       @db.VarChar(180)
  variantName String?      @db.VarChar(100)
  sku       String?        @db.VarChar(80)
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)
  totalPrice Decimal       @db.Decimal(12, 2)
  createdAt DateTime       @default(now())
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  provider          String?       @db.VarChar(50)
  providerPaymentId String?       @unique @db.VarChar(150)
  method            PaymentMethod
  status            PaymentStatus  @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR") @db.Char(3)
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([status, createdAt])
}

model Delivery {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @unique @db.Uuid
  deliveryPartnerId String?        @db.Uuid
  status            DeliveryStatus @default(PENDING)
  addressSnapshot   Json
  notes             String?
  estimatedAt       DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartner   User?          @relation("DeliveryPartner", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  @@index([deliveryPartnerId, status])
  @@index([status, createdAt])
}

model Coupon {
  id                String             @id @default(uuid()) @db.Uuid
  restaurantId      String?            @db.Uuid
  code              String             @unique @db.VarChar(50)
  description       String?
  discountType      CouponDiscountType
  value             Decimal            @db.Decimal(10, 2)
  minimumOrderValue Decimal            @default(0) @db.Decimal(12, 2)
  maximumDiscount   Decimal?           @db.Decimal(12, 2)
  usageLimit        Int?
  perUserLimit      Int?
  startsAt          DateTime
  expiresAt         DateTime
  status            CouponStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  restaurant        Restaurant?        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  carts             Cart[]
  orders            Order[]
  redemptions       CouponRedemption[]

  @@index([restaurantId, status])
  @@index([status, startsAt, expiresAt])
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @db.Uuid
  userId    String   @db.Uuid
  orderId   String   @unique @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

model Review {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  restaurantId String?      @db.Uuid
  productId    String?      @db.Uuid
  orderId      String?      @db.Uuid
  rating       Int
  title        String?      @db.VarChar(150)
  body         String?
  status       ReviewStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant?  @relation("RestaurantReviews", fields: [restaurantId], references: [id], onDelete: Cascade)
  product      Product?     @relation("ProductReviews", fields: [productId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, createdAt])
  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  type      NotificationType
  channel   NotificationChannel  @default(IN_APP)
  title     String               @db.VarChar(150)
  body      String
  data      Json?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
}

model Commission {
  id              String           @id @default(uuid()) @db.Uuid
  restaurantId    String           @db.Uuid
  orderId         String           @unique @db.Uuid
  payoutId        String?          @db.Uuid
  rate            Decimal          @db.Decimal(5, 2)
  orderAmount     Decimal          @db.Decimal(12, 2)
  commissionAmount Decimal         @db.Decimal(12, 2)
  status          CommissionStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payout          Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, createdAt])
  @@index([payoutId])
}

model Payout {
  id              String        @id @default(uuid()) @db.Uuid
  restaurantId    String        @db.Uuid
  periodStart     DateTime
  periodEnd       DateTime
  grossAmount     Decimal       @db.Decimal(12, 2)
  commissionAmount Decimal      @db.Decimal(12, 2)
  netAmount       Decimal       @db.Decimal(12, 2)
  status          PayoutStatus  @default(PENDING)
  providerReference String?     @unique @db.VarChar(150)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  commissions     Commission[]

  @@unique([restaurantId, periodStart, periodEnd])
  @@index([restaurantId, status, periodEnd])
}
